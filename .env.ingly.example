# INGLY Enterprise — variabili d'ambiente di esempio.
# Copia questo file in `.env` e adegua i valori:  cp .env.ingly.example .env
#
# Questi valori combaciano con il PostgreSQL di docker-compose.yml,
# così `docker compose up -d database` funziona senza modifiche.

# --- Database PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=postgres
# DB_SSLMODE=disable

# --- App ---
PORT=3000
NODE_ENV=development

# --- Email richieste preventivo (FACOLTATIVO) ---
# Se compili questi valori, ogni richiesta dal form "Contatti" arriva anche via
# email. Se li lasci vuoti, le richieste vengono comunque SALVATE nel database
# (tabella ingly_quote_request). Esempio con Gmail (serve una "password per app"):
#   1) Attiva la verifica in 2 passaggi sull'account Google
#   2) Crea una "password per le app" (Google Account → Sicurezza)
#   3) Usa quella password qui sotto in SMTP_PASS
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=tuoindirizzo@gmail.com
# SMTP_PASS=la-password-per-app-di-16-caratteri
# SMTP_FROM=tuoindirizzo@gmail.com
# INGLY_QUOTE_TO=dove-ricevere@inglydesign.it
