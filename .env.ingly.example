# INGLY Enterprise — variabili d'ambiente di esempio.
# Copia questo file in `.env` e adegua i valori:  cp .env.ingly.example .env
#
# Questi valori combaciano con il PostgreSQL di docker-compose.yml,
# così `docker compose up -d database` funziona senza modifiche.

# --- Database PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=postgres
# DB_SSLMODE=disable

# --- App ---
PORT=3000
NODE_ENV=development
